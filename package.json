{
  "name": "next-release-tag",
  "version": "1.0.0",
  "description": "Github Action to generate next Release Tag",
  "homepage": "https://github.com/amitsingh-007/next-release-tag#readme",
  "license": "MIT-open-group",
  "author": "amitsingh-007",
  "scripts": {
    "build": "tsdown",
    "dist": "pnpm lint:ci && pnpm typecheck && pnpm test && pnpm build",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
